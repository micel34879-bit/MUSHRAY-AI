# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies on the server.
# Optional in local dev (a random fallback is generated per boot if unset).
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Required to enable live INR subscription payments.
# Leave unset until you connect a verified Razorpay merchant account.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
